# Host Nginx terminates public TLS and proxies to this loopback-only gateway.
# Restrict substitution so nginx's own variables remain intact.
server {
    listen 80;
    listen [::]:80;
    server_name ${WEB_HOST};

    client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location ^~ /api/ {
        proxy_http_version 1.1;
        # The public API prefix is stripped before proxying.  Preserve the
        # application cookies' scope at the browser-facing /api/auth paths;
        # this changes only the Path attribute, not cookie values or security
        # attributes such as HttpOnly, Secure, SameSite, or Max-Age.
        proxy_cookie_path ~^/auth(?<dochub_auth_path>/.*)?$ /api/auth$dochub_auth_path;
        proxy_cookie_path /drive/integration/callback /api/drive/integration/callback;
        # Preview routes are also mounted without /api inside the API
        # container, so keep their capability cookies scoped to the public
        # browser-facing paths after this location strips /api.
        proxy_cookie_path ~^/preview(?<dochub_preview_path>/.*)?$ /api/preview$dochub_preview_path;
        proxy_cookie_path ~^/drive-preview(?<dochub_drive_preview_path>/.*)?$ /api/drive-preview$dochub_drive_preview_path;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_connect_timeout 10s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        proxy_pass http://api:3000/;
    }

    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
    }

    location = /index.html {
        root /usr/share/nginx/html;
        add_header Cache-Control "no-cache" always;
    }

    location ^~ /assets/ {
        root /usr/share/nginx/html;
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }
}
