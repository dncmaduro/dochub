# syntax=docker/dockerfile:1
FROM node:22.23.2-bookworm-slim AS build

WORKDIR /workspace
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0

RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl \
    && rm -rf /var/lib/apt/lists/*

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps ./apps
COPY packages ./packages

RUN corepack enable && corepack prepare pnpm@9.15.5 --activate \
    && pnpm install --frozen-lockfile \
    && pnpm --filter @dochub/database exec prisma generate \
    && pnpm build \
    && pnpm --filter worker --prod deploy /opt/worker \
    && cp -a /workspace/node_modules/.pnpm/@prisma+client@*/node_modules/.prisma \
      /opt/worker/node_modules/.pnpm/@prisma+client@*/node_modules/

FROM node:22.23.2-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production

RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /opt/worker /app
RUN chown -R node:node /app

USER node
CMD ["node", "dist/main.js"]
