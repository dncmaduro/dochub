# Development-only example. Copy to .env for local development. Production uses
# the untracked .env.production seeded from .env.production.example.
NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://dochub:dochub_dev@localhost:5433/dochub"
# Dedicated, disposable database for worker integration tests. Its name must
# end in _worker_test; apply migrations before running the suite.
# WORKER_TEST_DATABASE_URL="postgresql://dochub:dochub_dev@localhost:5433/dochub_worker_test"
TRASH_RETENTION_DAYS=30
# Standalone worker: delay after each cycle, maximum operations per cycle,
# and maximum simultaneous purge operations. Poll > 0 (Node timer range),
# batch 1..500, concurrency 1..8.
TRASH_RETENTION_POLL_SECONDS=60
TRASH_RETENTION_BATCH_SIZE=20
TRASH_RETENTION_OPERATION_CONCURRENCY=1

# File-processing worker. Tika is the sole PDF/Office parser; source bytes are
# streamed to it and extracted UTF-8 text is capped before persistence.
TIKA_URL=http://localhost:9998
FILE_PROCESSING_POLL_SECONDS=15
FILE_PROCESSING_BATCH_SIZE=20
FILE_PROCESSING_CONCURRENCY=2
FILE_PROCESSING_LEASE_SECONDS=300
FILE_PROCESSING_MAX_ATTEMPTS=5
TIKA_REQUEST_TIMEOUT_SECONDS=60
TIKA_MAX_TEXT_BYTES=16777216

# Binary storage is backend-relative: database storage keys never contain this
# physical root. Only the local driver is implemented at present.
STORAGE_DRIVER=local
STORAGE_ROOT=/absolute/path/to/dochub-storage
# Reserved for the forthcoming upload pipeline; keep outside the repository.
UPLOAD_TEMP_ROOT=/absolute/path/to/dochub-tmp/uploads
UPLOAD_MAX_BYTES=536870912

# Required for API startup. Use a distinct high-entropy value per environment.
AUTH_ACCESS_TOKEN_SECRET="replace-with-a-high-entropy-secret"
# Access-token lifetime in seconds (default: 900).
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
# Refresh-session lifetime in days (default: 30).
AUTH_REFRESH_TOKEN_TTL_DAYS=30
# Refresh-token cookie settings.
AUTH_REFRESH_COOKIE_NAME=dochub_refresh
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAME_SITE=lax
# Optional: AUTH_REFRESH_COOKIE_DOMAIN=example.com

# Optional. When unset, API CORS is disabled. Set to the exact web origin when
# browser credentialed requests are needed, for example http://localhost:5173.
# Multiple explicit origins may be comma-separated. Production requires HTTPS.
WEB_ORIGIN=http://localhost:5173

# API request/proxy policy. Node's JSON body parsing is bounded independently
# from streaming multipart uploads. Leave proxy hops at 0 unless the API is
# reachable only through that many controlled reverse proxies.
API_JSON_BODY_LIMIT_BYTES=1048576
TRUST_PROXY_HOPS=0

# Google OpenID Connect login. Configure all four values together to enable it.
# The redirect URI must exactly match the Google OAuth client configuration.
GOOGLE_CLIENT_ID="replace-with-google-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/auth/google/callback"
# Fixed post-login destination; user-supplied redirects are never accepted.
AUTH_LOGIN_SUCCESS_REDIRECT_URL="http://localhost:5173/auth/callback"

# Optional, separate Google Drive connection. It starts metadata-only; native
# creation requires explicit incremental write authorization. The redirect URI
# defaults to the Google login host/path with /drive/connection/callback when
# omitted; register that exact URI in the same Google OAuth client. The
# encryption key must be a distinct high-entropy secret (32+ characters).
# GOOGLE_DRIVE_REDIRECT_URI="http://localhost:3000/drive/connection/callback"
# DRIVE_TOKEN_ENCRYPTION_KEY="replace-with-a-distinct-high-entropy-drive-token-key"
# DRIVE_CONNECT_SUCCESS_REDIRECT_URL="http://localhost:5173/profile"
# Native Google Workspace creation uses the user's My Drive root by default.
# Set DRIVE_CREATION_PARENT_FOLDER_ID to a configured physical folder, or use
# SHARED_DRIVE with both DRIVE_CREATION_DRIVE_ID and DRIVE_CREATION_PARENT_FOLDER_ID.
# DRIVE_CREATION_TARGET_TYPE=MY_DRIVE
# DRIVE_CREATION_PARENT_FOLDER_ID=""
# DRIVE_CREATION_DRIVE_ID=""

# Production requires NODE_ENV=production, an HTTPS WEB_ORIGIN, Google OIDC,
# AUTH_REFRESH_COOKIE_SECURE=true, and non-placeholder secrets of 32+ chars.
# Use .env.production.example for the complete production-only host, TLS,
# database, internal service-DNS, and resource-limit settings. Configure HSTS
# at the HTTPS reverse proxy. Do not commit real values here.

# ONLYOFFICE Docs integration. Keep the two secrets independent from auth JWTs.
ONLYOFFICE_PUBLIC_URL=http://localhost:8082
ONLYOFFICE_INTERNAL_API_URL=http://host.docker.internal:3000
ONLYOFFICE_JWT_SECRET="replace-with-a-distinct-high-entropy-onlyoffice-secret"
ONLYOFFICE_FETCH_TOKEN_SECRET="replace-with-a-distinct-high-entropy-fetch-secret"
ONLYOFFICE_FETCH_TOKEN_TTL_SECONDS=900
# Purpose-bound server-to-server callback capability. Defaults to 3600 when omitted.
ONLYOFFICE_CALLBACK_TOKEN_TTL_SECONDS=3600
# After the editor UI closes, accept its signed final save callback for this
# bounded server-side grace period. Must not exceed callback token TTL.
ONLYOFFICE_EDIT_CLOSE_GRACE_SECONDS=60

# Redis is not used by current application code. It is deliberately excluded
# from the production stack.
