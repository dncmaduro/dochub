DATABASE_URL="postgresql://dochub:dochub_dev@localhost:5433/dochub"
REDIS_URL="redis://localhost:6379"
TRASH_RETENTION_DAYS=30
# Standalone worker: delay after each cycle, maximum operations per cycle,
# and maximum simultaneous purge operations. Poll > 0 (Node timer range),
# batch 1..500, concurrency 1..8.
TRASH_RETENTION_POLL_SECONDS=60
TRASH_RETENTION_BATCH_SIZE=20
TRASH_RETENTION_OPERATION_CONCURRENCY=1

# File-processing worker. Tika is the sole PDF/Office parser; source bytes are
# streamed to it and extracted UTF-8 text is capped before persistence.
TIKA_URL=http://localhost:9998
FILE_PROCESSING_POLL_SECONDS=15
FILE_PROCESSING_BATCH_SIZE=20
FILE_PROCESSING_CONCURRENCY=2
FILE_PROCESSING_LEASE_SECONDS=300
FILE_PROCESSING_MAX_ATTEMPTS=5
TIKA_REQUEST_TIMEOUT_SECONDS=60
TIKA_MAX_TEXT_BYTES=16777216

# Binary storage is backend-relative: database storage keys never contain this
# physical root. Only the local driver is implemented at present.
STORAGE_DRIVER=local
STORAGE_ROOT=/absolute/path/to/dochub-storage
# Reserved for the forthcoming upload pipeline; keep outside the repository.
UPLOAD_TEMP_ROOT=/absolute/path/to/dochub-tmp/uploads
UPLOAD_MAX_BYTES=536870912

# Required for API startup. Use a distinct high-entropy value per environment.
AUTH_ACCESS_TOKEN_SECRET="replace-with-a-high-entropy-secret"
# Access-token lifetime in seconds (default: 900).
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
# Refresh-session lifetime in days (default: 30).
AUTH_REFRESH_TOKEN_TTL_DAYS=30
# Refresh-token cookie settings.
AUTH_REFRESH_COOKIE_NAME=dochub_refresh
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAME_SITE=lax
# Optional: AUTH_REFRESH_COOKIE_DOMAIN=example.com

# Optional. When unset, API CORS is disabled. Set to the exact web origin when
# browser credentialed requests are needed, for example http://localhost:5173.
WEB_ORIGIN=http://localhost:5173

# Google OpenID Connect login. Configure all four values together to enable it.
# The redirect URI must exactly match the Google OAuth client configuration.
GOOGLE_CLIENT_ID="replace-with-google-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/auth/google/callback"
# Fixed post-login destination; user-supplied redirects are never accepted.
AUTH_LOGIN_SUCCESS_REDIRECT_URL="http://localhost:5173/auth/callback"

# ONLYOFFICE Docs integration. Keep the two secrets independent from auth JWTs.
ONLYOFFICE_PUBLIC_URL=http://localhost:8082
ONLYOFFICE_INTERNAL_API_URL=http://host.docker.internal:3000
ONLYOFFICE_JWT_SECRET="replace-with-a-distinct-high-entropy-onlyoffice-secret"
ONLYOFFICE_FETCH_TOKEN_SECRET="replace-with-a-distinct-high-entropy-fetch-secret"
ONLYOFFICE_FETCH_TOKEN_TTL_SECONDS=900
# Purpose-bound server-to-server callback capability. Defaults to 3600 when omitted.
ONLYOFFICE_CALLBACK_TOKEN_TTL_SECONDS=3600
