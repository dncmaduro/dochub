generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  INVITED
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
}

enum SystemRole {
  ADMIN
  DOCUMENT_MANAGER
  VIEWER
}

enum AuthProvider {
  GOOGLE
}

enum NodeType {
  FILE
  FOLDER
}

enum FileBackingType {
  LOCAL
  GOOGLE_DRIVE
}

enum DriveFileMigrationStatus {
  PENDING
  UPLOADING
  UPLOADED
  VERIFYING
  VERIFIED
  COMPLETED
  FAILED
  BLOCKED
  STALE
  ROLLED_BACK
}

enum TrashOperationStatus {
  ACTIVE
  RESTORED
  PURGING
  PURGED
}

enum AuditActorType {
  USER
  PUBLIC
  SYSTEM
  COLLABORATIVE
}

enum AuditResult {
  SUCCESS
  DENIED
  FAILED
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum FileProcessingTaskType {
  VALIDATION
  METADATA
  THUMBNAIL
  TEXT_EXTRACTION
  SEARCH_INDEX
  VIRUS_SCAN
}

enum FileProcessingTaskStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum EditorActorType {
  USER
  PUBLIC
}

enum EditorMode {
  VIEW
  EDIT
}

enum EditorSessionStatus {
  ACTIVE
  CLOSED
  FAILED
}

enum GeneralAccessRole {
  RESTRICTED
  VIEWER
  EDITOR
}

enum DriveSyncStatus {
  NEVER_SYNCED
  SYNCING
  SYNCED
  FAILED
}

enum DriveFileType {
  FOLDER
  GOOGLE_DOC
  GOOGLE_SHEET
  GOOGLE_SLIDE
  PDF
  IMAGE
  VIDEO
  DOCX
  XLSX
  PPTX
  BINARY
}

enum DriveFileLocation {
  MY_DRIVE
  SHARED_WITH_ME
  SHARED_DRIVE
  UNKNOWN
}

enum DriveSourceStatus {
  CONNECTED
  STALE
  UNAVAILABLE
}

enum DriveNativeDocumentKind {
  DOCUMENT
  SPREADSHEET
  PRESENTATION
}

enum DriveCreationOperationStatus {
  IN_PROGRESS
  SUCCEEDED
  FAILED
}

enum DriveUploadOperationStatus {
  IN_PROGRESS
  SUCCEEDED
  FAILED
}

model User {
  id                       String                   @id @default(uuid()) @db.Uuid
  email                    String
  normalizedEmail          String                   @unique
  displayName              String
  status                   UserStatus               @default(INVITED)
  systemRole               SystemRole               @default(VIEWER)
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  authAccounts             AuthAccount[]
  sessions                 Session[]
  createdGroups            Group[]                  @relation("GroupCreatedBy")
  groupMemberships         GroupMember[]            @relation("GroupMemberUser")
  addedGroupMembers        GroupMember[]            @relation("GroupMemberAddedBy")
  createdNodes             Node[]                   @relation("NodeCreatedBy")
  updatedNodes             Node[]                   @relation("NodeUpdatedBy")
  createdFileVersions      FileVersion[]            @relation("FileVersionCreatedBy")
  permissionEntries        PermissionEntry[]        @relation("PermissionEntryUser")
  createdPermissionEntries PermissionEntry[]        @relation("PermissionEntryCreatedBy")
  trashOperations          TrashOperation[]         @relation("TrashOperationTrashedBy")
  auditLogEntries          AuditLog[]               @relation("AuditLogActor")
  editorSessions           EditorSession[]          @relation("EditorSessionUser")
  favorites                Favorite[]               @relation("FavoriteUser")
  recentItems              RecentItem[]             @relation("RecentItemUser")
  driveConnection          DriveConnection?
  driveCreationOperations  DriveCreationOperation[]
  driveUploadOperations    DriveUploadOperation[]
}

// Docs Hub has one company-wide Google Drive integration and one physical
// storage-folder target. The nullable shared-drive fields are retained for
// compatibility with legacy rows; singletonKey keeps the company invariant
// explicit without introducing tenancy into the rest of the schema.
model GoogleDriveIntegration {
  id                    String               @id @default(uuid()) @db.Uuid
  singletonKey          String               @unique @default("company")
  sharedDriveId         String?
  sharedDriveName       String?
  storageFolderId       String?
  storageFolderName     String?
  googleAccountId       String?
  googleEmail           String?
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  connectedAt           DateTime?
  updatedAt             DateTime             @updatedAt
  accessTokenExpiresAt  DateTime?
  syncStatus            DriveSyncStatus      @default(NEVER_SYNCED)
  lastSyncStartedAt     DateTime?
  lastSyncCompletedAt   DateTime?
  lastSyncError         String?
  revokedAt             DateTime?
  authorizedScopes      String[]             @default([])
  files                 DriveFile[]
  migrations            DriveFileMigration[]

  @@index([revokedAt])
  @@index([syncStatus])
}

model AuthAccount {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @db.Uuid
  provider          AuthProvider
  providerAccountId String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
}

model Group {
  id                String            @id @default(uuid()) @db.Uuid
  name              String
  normalizedName    String            @unique
  description       String?
  createdById       String            @db.Uuid
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  createdBy         User              @relation("GroupCreatedBy", fields: [createdById], references: [id])
  members           GroupMember[]
  permissionEntries PermissionEntry[] @relation("PermissionEntryGroup")
}

model GroupMember {
  groupId   String   @db.Uuid
  userId    String   @db.Uuid
  addedById String   @db.Uuid
  createdAt DateTime @default(now())
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User     @relation("GroupMemberUser", fields: [userId], references: [id])
  addedBy   User     @relation("GroupMemberAddedBy", fields: [addedById], references: [id])

  @@id([groupId, userId])
  @@index([userId])
}

// Active-name uniqueness is enforced by partial indexes in the Trash lifecycle migration.
model Node {
  // UUIDv4 is stable and also identifies the canonical /document/<id> URL.
  id                                String            @id @default(uuid()) @db.Uuid
  parentId                          String?           @db.Uuid
  type                              NodeType
  name                              String
  normalizedName                    String
  inheritPermissions                Boolean           @default(true)
  generalAccessRole                 GeneralAccessRole @default(VIEWER)
  createdById                       String            @db.Uuid
  updatedById                       String?           @db.Uuid
  createdAt                         DateTime          @default(now())
  updatedAt                         DateTime          @updatedAt
  parent                            Node?             @relation("NodeHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children                          Node[]            @relation("NodeHierarchy")
  createdBy                         User              @relation("NodeCreatedBy", fields: [createdById], references: [id])
  updatedBy                         User?             @relation("NodeUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  // FILE nodes have either local versioned content or a metadata-only external backing.
  file                              File?
  permissionEntries                 PermissionEntry[]
  trashOperationId                  String?           @db.Uuid
  trashOperation                    TrashOperation?   @relation("TrashOperationNodes", fields: [trashOperationId], references: [id], onDelete: Restrict)
  trashOperationsAsRoot             TrashOperation[]  @relation("TrashOperationRootNode")
  trashOperationsWithOriginalParent TrashOperation[]  @relation("TrashOperationOriginalParent")
  favorites                         Favorite[]        @relation("FavoriteNode")
  recentItems                       RecentItem[]      @relation("RecentItemNode")

  @@index([parentId])
  @@index([createdById])
  @@index([trashOperationId])
}

enum FileVersionSource {
  UPLOAD
  EDITOR
  RESTORE
  SYSTEM
}

enum FileVersionActorType {
  USER
  PUBLIC
  SYSTEM
  COLLABORATIVE
}

enum DocumentRole {
  VIEWER
  EDITOR
  OWNER
}

model File {
  id               String               @id @default(uuid()) @db.Uuid
  nodeId           String               @unique @db.Uuid
  backingType      FileBackingType      @default(LOCAL)
  driveFileId      String?              @unique @db.Uuid
  currentVersionId String?              @db.Uuid
  versionCounter   Int                  @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  node             Node                 @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  driveFile        DriveFile?           @relation(fields: [driveFileId], references: [id], onDelete: Restrict)
  versions         FileVersion[]        @relation("FileVersions")
  currentVersion   FileVersion?         @relation("FileCurrentVersion", fields: [id, currentVersionId], references: [fileId, id], onDelete: Restrict)
  searchDocument   SearchDocument?      @relation("SearchDocumentFile")
  editorSessions   EditorSession[]      @relation("EditorSessionFile")
  driveMigrations  DriveFileMigration[]

  // Required by Prisma for the composite current-version ownership relation.
  @@unique([id, currentVersionId])
}

model FileVersion {
  id                              String               @id @default(uuid()) @db.Uuid
  fileId                          String               @db.Uuid
  versionNumber                   Int
  storageKey                      String               @unique
  originalFilename                String
  mimeType                        String
  extension                       String?
  sizeBytes                       BigInt
  sha256                          String
  source                          FileVersionSource
  actorType                       FileVersionActorType @default(SYSTEM)
  sourceVersionId                 String?              @db.Uuid
  createdById                     String?              @db.Uuid
  createdAt                       DateTime             @default(now())
  file                            File                 @relation("FileVersions", fields: [fileId], references: [id], onDelete: Restrict)
  currentForFile                  File?                @relation("FileCurrentVersion")
  sourceVersion                   FileVersion?         @relation("FileVersionRestoreSource", fields: [sourceVersionId], references: [id], onDelete: SetNull)
  versionsRestoredFromThisVersion FileVersion[]        @relation("FileVersionRestoreSource")
  createdBy                       User?                @relation("FileVersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  processingTasks                 FileProcessingTask[] @relation("FileVersionProcessingTasks")
  indexedSearchDocuments          SearchDocument[]     @relation("SearchDocumentIndexedVersion")
  editorSessionsBasedOnVersion    EditorSession[]      @relation("EditorSessionBaseVersion")
  finalizedEditorSessions         EditorSession[]      @relation("EditorSessionFinalizedVersion")
  driveMigrations                 DriveFileMigration[] @relation("DriveFileMigrationSourceVersion")

  @@unique([fileId, versionNumber])
  @@unique([fileId, id])
  @@index([fileId])
}

model PermissionEntry {
  id          String       @id @default(uuid()) @db.Uuid
  nodeId      String       @db.Uuid
  userId      String?      @db.Uuid
  groupId     String?      @db.Uuid
  role        DocumentRole
  createdById String?      @db.Uuid
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  node        Node         @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  user        User?        @relation("PermissionEntryUser", fields: [userId], references: [id], onDelete: Cascade)
  group       Group?       @relation("PermissionEntryGroup", fields: [groupId], references: [id], onDelete: Cascade)
  createdBy   User?        @relation("PermissionEntryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([nodeId, userId])
  @@unique([nodeId, groupId])
  @@index([userId])
  @@index([groupId])
}

model TrashOperation {
  id               String               @id @default(uuid()) @db.Uuid
  rootNodeId       String?              @db.Uuid
  originalParentId String?              @db.Uuid
  trashedById      String?              @db.Uuid
  status           TrashOperationStatus @default(ACTIVE)
  trashedAt        DateTime             @default(now())
  expiresAt        DateTime
  restoredAt       DateTime?
  purgedAt         DateTime?
  rootNode         Node?                @relation("TrashOperationRootNode", fields: [rootNodeId], references: [id], onDelete: SetNull)
  originalParent   Node?                @relation("TrashOperationOriginalParent", fields: [originalParentId], references: [id], onDelete: SetNull)
  trashedBy        User?                @relation("TrashOperationTrashedBy", fields: [trashedById], references: [id], onDelete: SetNull)
  nodes            Node[]               @relation("TrashOperationNodes")

  @@index([status, expiresAt])
}

model AuditLog {
  id           String         @id @default(uuid()) @db.Uuid
  actorType    AuditActorType
  actorId      String?        @db.Uuid
  action       String
  resourceType String
  resourceId   String?        @db.Uuid
  result       AuditResult
  ipAddress    String?
  userAgent    String?
  metadata     Json
  createdAt    DateTime       @default(now())
  actor        User?          @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([resourceId, createdAt])
  @@index([action, createdAt])
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  eventType     String
  aggregateType String
  aggregateId   String?      @db.Uuid
  payload       Json
  status        OutboxStatus @default(PENDING)
  attemptCount  Int          @default(0)
  lastError     String?
  createdAt     DateTime     @default(now())
  publishedAt   DateTime?

  @@index([status, createdAt])
}

model FileProcessingTask {
  id             String                   @id @default(uuid()) @db.Uuid
  fileVersionId  String                   @db.Uuid
  type           FileProcessingTaskType
  status         FileProcessingTaskStatus @default(PENDING)
  attemptCount   Int                      @default(0)
  lastError      String?
  startedAt      DateTime?
  availableAt    DateTime                 @default(now())
  leaseExpiresAt DateTime?
  leaseToken     String?                  @db.Uuid
  completedAt    DateTime?
  createdAt      DateTime                 @default(now())
  fileVersion    FileVersion              @relation("FileVersionProcessingTasks", fields: [fileVersionId], references: [id], onDelete: Cascade)

  @@unique([fileVersionId, type])
  @@index([status, createdAt])
  @@index([status, availableAt])
}

model SearchDocument {
  id            String                   @id @default(uuid()) @db.Uuid
  fileId        String                   @unique @db.Uuid
  fileVersionId String                   @db.Uuid
  contentText   String
  searchVector  Unsupported("tsvector")?
  indexedAt     DateTime                 @default(now())
  file          File                     @relation("SearchDocumentFile", fields: [fileId], references: [id], onDelete: Cascade)
  fileVersion   FileVersion              @relation("SearchDocumentIndexedVersion", fields: [fileVersionId], references: [id], onDelete: Cascade)

  @@index([fileVersionId])
}

model EditorSession {
  id                     String              @id @default(uuid()) @db.Uuid
  fileId                 String              @db.Uuid
  baseVersionId          String              @db.Uuid
  documentKey            String
  actorType              EditorActorType
  userId                 String?             @db.Uuid
  mode                   EditorMode
  status                 EditorSessionStatus @default(ACTIVE)
  createdAt              DateTime            @default(now())
  closedAt               DateTime?
  stagedArtifactId       String?             @db.Uuid
  stagedSha256           String?
  stagedSizeBytes        BigInt?
  stagedAt               DateTime?
  finalizedFileVersionId String?             @db.Uuid
  finalizedAt            DateTime?
  file                   File                @relation("EditorSessionFile", fields: [fileId], references: [id], onDelete: Restrict)
  baseVersion            FileVersion         @relation("EditorSessionBaseVersion", fields: [fileId, baseVersionId], references: [fileId, id], onDelete: Restrict)
  finalizedFileVersion   FileVersion?        @relation("EditorSessionFinalizedVersion", fields: [finalizedFileVersionId], references: [id], onDelete: Restrict)
  user                   User?               @relation("EditorSessionUser", fields: [userId], references: [id], onDelete: Restrict)

  @@index([documentKey])
  @@index([fileId, baseVersionId, documentKey, mode, status])
}

model Favorite {
  userId    String   @db.Uuid
  nodeId    String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation("FavoriteUser", fields: [userId], references: [id], onDelete: Cascade)
  node      Node     @relation("FavoriteNode", fields: [nodeId], references: [id], onDelete: Cascade)

  @@id([userId, nodeId])
}

model RecentItem {
  userId         String   @db.Uuid
  nodeId         String   @db.Uuid
  lastAccessedAt DateTime @default(now())
  user           User     @relation("RecentItemUser", fields: [userId], references: [id], onDelete: Cascade)
  node           Node     @relation("RecentItemNode", fields: [nodeId], references: [id], onDelete: Cascade)

  @@id([userId, nodeId])
  @@index([userId, lastAccessedAt])
}

model DriveConnection {
  id                    String               @id @default(uuid()) @db.Uuid
  userId                String               @unique @db.Uuid
  googleAccountId       String?
  googleEmail           String?
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  connectedAt           DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  accessTokenExpiresAt  DateTime?
  syncStatus            DriveSyncStatus      @default(NEVER_SYNCED)
  lastSyncStartedAt     DateTime?
  lastSyncCompletedAt   DateTime?
  lastSyncError         String?
  revokedAt             DateTime?
  authorizedScopes      String[]             @default([])
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([revokedAt])
  @@index([syncStatus])
}

model DriveCreationOperation {
  idempotencyKey String                       @id
  userId         String                       @db.Uuid
  kind           DriveNativeDocumentKind
  parentId       String?                      @db.Uuid
  locale         String
  name           String
  status         DriveCreationOperationStatus @default(IN_PROGRESS)
  driveFileId    String?
  nodeId         String?                      @db.Uuid
  errorMessage   String?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  user           User                         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model DriveUploadOperation {
  idempotencyKey   String                     @id
  userId           String                     @db.Uuid
  parentId         String?                    @db.Uuid
  originalFilename String
  name             String
  mimeType         String
  sizeBytes        BigInt?
  sha256           String?
  status           DriveUploadOperationStatus @default(IN_PROGRESS)
  driveFileId      String?
  nodeId           String?                    @db.Uuid
  errorMessage     String?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  user             User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model DriveFileMigration {
  id                String                   @id @default(uuid()) @db.Uuid
  fileId            String                   @db.Uuid
  sourceVersionId   String                   @db.Uuid
  status            DriveFileMigrationStatus @default(PENDING)
  attempts          Int                      @default(0)
  driveIntegrationId String?                 @db.Uuid
  driveFileRecordId String?                  @db.Uuid
  remoteDriveFileId String?
  sourceSha256      String
  sourceSizeBytes   BigInt
  remoteName        String?
  remoteMimeType    String?
  remoteSizeBytes   BigInt?
  remoteMd5Checksum String?
  leaseToken        String?                  @db.Uuid
  leaseExpiresAt    DateTime?
  startedAt         DateTime?
  uploadedAt        DateTime?
  verifiedAt        DateTime?
  completedAt       DateTime?
  failedAt          DateTime?
  lastErrorCode     String?
  lastErrorSummary  String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  file              File                     @relation(fields: [fileId], references: [id], onDelete: Restrict)
  sourceVersion     FileVersion              @relation("DriveFileMigrationSourceVersion", fields: [sourceVersionId], references: [id], onDelete: Restrict)
  driveIntegration  GoogleDriveIntegration?  @relation(fields: [driveIntegrationId], references: [id], onDelete: SetNull)
  driveFile         DriveFile?               @relation("DriveFileMigrationTarget", fields: [driveFileRecordId], references: [id], onDelete: SetNull)

  @@unique([fileId, sourceVersionId])
  @@index([status, createdAt])
  @@index([fileId, createdAt])
  @@index([leaseExpiresAt])
}

model DriveFile {
  id                String               @id @default(uuid()) @db.Uuid
  driveIntegrationId String              @db.Uuid
  driveFileId       String
  name              String
  mimeType          String
  normalizedType    DriveFileType
  webViewLink       String?
  driveModifiedTime DateTime?
  driveCreatedTime  DateTime?
  trashed           Boolean              @default(false)
  driveParents      String[]             @default([])
  location          DriveFileLocation    @default(UNKNOWN)
  sharedDriveId     String?
  sizeBytes         BigInt?
  driveVersion      String?
  sourceStatus      DriveSourceStatus    @default(CONNECTED)
  syncedAt          DateTime             @default(now())
  driveIntegration  GoogleDriveIntegration @relation(fields: [driveIntegrationId], references: [id], onDelete: Restrict)
  docsHubFile       File?
  migrations        DriveFileMigration[] @relation("DriveFileMigrationTarget")

  @@unique([driveFileId])
  @@index([driveIntegrationId, driveModifiedTime])
  @@index([driveIntegrationId, normalizedType])
}
