generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum SystemRole {
  ADMIN
  MEMBER
}

enum AuthProvider {
  GOOGLE
}

enum NodeType {
  FILE
  FOLDER
}

enum TrashOperationStatus {
  ACTIVE
  RESTORED
  PURGING
  PURGED
}

enum AuditActorType {
  USER
  PUBLIC
  SYSTEM
}

enum AuditResult {
  SUCCESS
  DENIED
  FAILED
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

model User {
  id                       String            @id @default(uuid()) @db.Uuid
  email                    String
  normalizedEmail          String            @unique
  displayName              String
  status                   UserStatus        @default(INVITED)
  systemRole               SystemRole        @default(MEMBER)
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  authAccounts             AuthAccount[]
  sessions                 Session[]
  createdGroups            Group[]           @relation("GroupCreatedBy")
  groupMemberships         GroupMember[]     @relation("GroupMemberUser")
  addedGroupMembers        GroupMember[]     @relation("GroupMemberAddedBy")
  createdNodes             Node[]            @relation("NodeCreatedBy")
  updatedNodes             Node[]            @relation("NodeUpdatedBy")
  createdFileVersions      FileVersion[]     @relation("FileVersionCreatedBy")
  permissionEntries        PermissionEntry[] @relation("PermissionEntryUser")
  createdPermissionEntries PermissionEntry[] @relation("PermissionEntryCreatedBy")
  createdShareLinks        ShareLink[]       @relation("ShareLinkCreatedBy")
  trashOperations          TrashOperation[]  @relation("TrashOperationTrashedBy")
  auditLogEntries          AuditLog[]        @relation("AuditLogActor")
}

model AuthAccount {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @db.Uuid
  provider          AuthProvider
  providerAccountId String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
}

model Group {
  id                String            @id @default(uuid()) @db.Uuid
  name              String
  normalizedName    String            @unique
  description       String?
  createdById       String            @db.Uuid
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  createdBy         User              @relation("GroupCreatedBy", fields: [createdById], references: [id])
  members           GroupMember[]
  permissionEntries PermissionEntry[] @relation("PermissionEntryGroup")
}

model GroupMember {
  groupId   String   @db.Uuid
  userId    String   @db.Uuid
  addedById String   @db.Uuid
  createdAt DateTime @default(now())
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User     @relation("GroupMemberUser", fields: [userId], references: [id])
  addedBy   User     @relation("GroupMemberAddedBy", fields: [addedById], references: [id])

  @@id([groupId, userId])
  @@index([userId])
}

// Active-name uniqueness is enforced by partial indexes in the Trash lifecycle migration.
model Node {
  id                                String            @id @default(uuid()) @db.Uuid
  parentId                          String?           @db.Uuid
  type                              NodeType
  name                              String
  normalizedName                    String
  inheritPermissions                Boolean           @default(true)
  publicAccess                      Boolean           @default(false)
  createdById                       String            @db.Uuid
  updatedById                       String?           @db.Uuid
  createdAt                         DateTime          @default(now())
  updatedAt                         DateTime          @updatedAt
  parent                            Node?             @relation("NodeHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children                          Node[]            @relation("NodeHierarchy")
  createdBy                         User              @relation("NodeCreatedBy", fields: [createdById], references: [id])
  updatedBy                         User?             @relation("NodeUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  // Node.type = FILE iff a File row exists is an application/domain invariant.
  file                              File?
  permissionEntries                 PermissionEntry[]
  shareLinks                        ShareLink[]
  trashOperationId                  String?           @db.Uuid
  trashOperation                    TrashOperation?   @relation("TrashOperationNodes", fields: [trashOperationId], references: [id], onDelete: Restrict)
  trashOperationsAsRoot             TrashOperation[]  @relation("TrashOperationRootNode")
  trashOperationsWithOriginalParent TrashOperation[]  @relation("TrashOperationOriginalParent")

  @@index([parentId])
  @@index([createdById])
  @@index([trashOperationId])
}

enum FileVersionSource {
  UPLOAD
  EDITOR
  RESTORE
  SYSTEM
}

enum DocumentRole {
  VIEWER
  EDITOR
  OWNER
}

model File {
  id               String        @id @default(uuid()) @db.Uuid
  nodeId           String        @unique @db.Uuid
  currentVersionId String?       @db.Uuid
  versionCounter   Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  node             Node          @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  versions         FileVersion[] @relation("FileVersions")
  currentVersion   FileVersion?  @relation("FileCurrentVersion", fields: [id, currentVersionId], references: [fileId, id], onDelete: Restrict)

  // Required by Prisma for the composite current-version ownership relation.
  @@unique([id, currentVersionId])
}

model FileVersion {
  id                              String            @id @default(uuid()) @db.Uuid
  fileId                          String            @db.Uuid
  versionNumber                   Int
  storageKey                      String            @unique
  originalFilename                String
  mimeType                        String
  extension                       String?
  sizeBytes                       BigInt
  sha256                          String
  source                          FileVersionSource
  sourceVersionId                 String?           @db.Uuid
  createdById                     String?           @db.Uuid
  createdAt                       DateTime          @default(now())
  file                            File              @relation("FileVersions", fields: [fileId], references: [id], onDelete: Restrict)
  currentForFile                  File?             @relation("FileCurrentVersion")
  sourceVersion                   FileVersion?      @relation("FileVersionRestoreSource", fields: [sourceVersionId], references: [id], onDelete: SetNull)
  versionsRestoredFromThisVersion FileVersion[]     @relation("FileVersionRestoreSource")
  createdBy                       User?             @relation("FileVersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([fileId, versionNumber])
  @@unique([fileId, id])
  @@index([fileId])
}

model PermissionEntry {
  id          String       @id @default(uuid()) @db.Uuid
  nodeId      String       @db.Uuid
  userId      String?      @db.Uuid
  groupId     String?      @db.Uuid
  role        DocumentRole
  createdById String?      @db.Uuid
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  node        Node         @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  user        User?        @relation("PermissionEntryUser", fields: [userId], references: [id], onDelete: Cascade)
  group       Group?       @relation("PermissionEntryGroup", fields: [groupId], references: [id], onDelete: Cascade)
  createdBy   User?        @relation("PermissionEntryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([nodeId, userId])
  @@unique([nodeId, groupId])
  @@index([userId])
  @@index([groupId])
}

model ShareLink {
  id          String    @id @default(uuid()) @db.Uuid
  nodeId      String    @db.Uuid
  tokenHash   String    @unique
  createdById String?   @db.Uuid
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
  node        Node      @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  createdBy   User?     @relation("ShareLinkCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
}

model TrashOperation {
  id               String               @id @default(uuid()) @db.Uuid
  rootNodeId       String?              @db.Uuid
  originalParentId String?              @db.Uuid
  trashedById      String?              @db.Uuid
  status           TrashOperationStatus @default(ACTIVE)
  trashedAt        DateTime             @default(now())
  expiresAt        DateTime
  restoredAt       DateTime?
  purgedAt         DateTime?
  rootNode         Node?                @relation("TrashOperationRootNode", fields: [rootNodeId], references: [id], onDelete: SetNull)
  originalParent   Node?                @relation("TrashOperationOriginalParent", fields: [originalParentId], references: [id], onDelete: SetNull)
  trashedBy        User?                @relation("TrashOperationTrashedBy", fields: [trashedById], references: [id], onDelete: SetNull)
  nodes            Node[]               @relation("TrashOperationNodes")

  @@index([status, expiresAt])
}

model AuditLog {
  id           String         @id @default(uuid()) @db.Uuid
  actorType    AuditActorType
  actorId      String?        @db.Uuid
  action       String
  resourceType String
  resourceId   String?        @db.Uuid
  result       AuditResult
  ipAddress    String?
  userAgent    String?
  metadata     Json
  createdAt    DateTime       @default(now())
  actor        User?          @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([resourceId, createdAt])
  @@index([action, createdAt])
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  eventType     String
  aggregateType String
  aggregateId   String?      @db.Uuid
  payload       Json
  status        OutboxStatus @default(PENDING)
  attemptCount  Int          @default(0)
  lastError     String?
  createdAt     DateTime     @default(now())
  publishedAt   DateTime?

  @@index([status, createdAt])
}
