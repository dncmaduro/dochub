# Copy to /srv/dochub/.backup.env, fill in remote credentials, then chmod 600.
# Never commit real values or add backup credentials to .env.production.
RESTIC_REPOSITORY=s3:s3.amazonaws.com/example-dochub-backups
RESTIC_PASSWORD_FILE=/srv/dochub/.restic-password
# Backend-specific variables (for example AWS_ACCESS_KEY_ID) belong here.
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
BACKUP_PRUNE=0
BACKUP_MAX_AGE_HOURS=30
# 1 GiB default temporary-dump floor. Review as PostgreSQL grows.
BACKUP_MIN_FREE_KB=1048576
# Prefer a separate host/volume with adequate capacity for drills.
RESTORE_DRILL_ROOT=/srv/dochub/restore-drills
