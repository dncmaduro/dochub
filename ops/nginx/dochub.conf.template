# Sanitized host-Nginx recovery reference. Install only after obtaining a
# certificate; do not commit private keys or copy unrelated virtual hosts.
# Replace the ACME root if the host uses a different Certbot webroot.
server {
  listen 80;
  server_name docshub.space office.docshub.space;
  location ^~ /.well-known/acme-challenge/ { root /var/www/dochub-acme; default_type text/plain; }
  location / { return 301 https://$host$request_uri; }
}
server {
  listen 443 ssl http2;
  server_name docshub.space;
  ssl_certificate /etc/letsencrypt/live/docshub.space/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/docshub.space/privkey.pem;
  # Reapply these audited host protections during recovery.
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "no-referrer" always;
  add_header X-Frame-Options "DENY" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
  client_max_body_size 513m;
  location / { proxy_http_version 1.1; proxy_request_buffering off; proxy_set_header Host $host; proxy_set_header X-Real-IP $remote_addr; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Host $host; proxy_set_header X-Forwarded-Proto $scheme; proxy_connect_timeout 10s; proxy_send_timeout 300s; proxy_read_timeout 300s; proxy_pass http://127.0.0.1:8081; }
}
server {
  listen 443 ssl http2;
  server_name office.docshub.space;
  ssl_certificate /etc/letsencrypt/live/docshub.space/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/docshub.space/privkey.pem;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "no-referrer" always;
  location / { proxy_http_version 1.1; proxy_set_header Host $host; proxy_set_header X-Real-IP $remote_addr; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Host $host; proxy_set_header X-Forwarded-Proto $scheme; proxy_set_header Upgrade $http_upgrade; proxy_set_header Connection "upgrade"; proxy_connect_timeout 10s; proxy_send_timeout 300s; proxy_read_timeout 300s; proxy_pass http://127.0.0.1:8082; }
}
