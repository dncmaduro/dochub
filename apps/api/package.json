{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node --env-file-if-exists=../../.env ./node_modules/@nestjs/cli/bin/nest.js start",
    "start:dev": "node --env-file-if-exists=../../.env ./node_modules/@nestjs/cli/bin/nest.js start --watch",
    "start:debug": "node --env-file-if-exists=../../.env ./node_modules/@nestjs/cli/bin/nest.js start --debug --watch",
    "start:prod": "node --env-file-if-exists=../../.env dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "test": "node --env-file-if-exists=../../.env ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node --env-file-if-exists=../../.env ./node_modules/vitest/vitest.mjs",
    "test:cov": "node --env-file-if-exists=../../.env ./node_modules/vitest/vitest.mjs run --coverage",
    "test:debug": "node --env-file-if-exists=../../.env ./node_modules/vitest/vitest.mjs --inspect-brk --no-file-parallelism",
    "test:e2e": "node --env-file-if-exists=../../.env ./node_modules/vitest/vitest.mjs run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@dochub/database": "workspace:*",
    "@dochub/storage": "workspace:*",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "busboy": "^1.6.0",
    "cookie-parser": "^1.4.7",
    "file-type": "^21.0.0",
    "openid-client": "^6.8.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}
