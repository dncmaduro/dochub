# Copy to /srv/dochub/.env.production, set mode 0600, and replace every
# placeholder. This file is safe to track; it must never contain real secrets.
# Values are read by docker compose and passed only to the services that need
# them. Browser traffic uses https://${WEB_HOST}; API traffic uses /api.

# REQUIRED: host paths. Create these before first deploy. Containers use the
# fixed internal paths /data/storage and /data/uploads below.
DOCHUB_STORAGE_HOST_PATH=/srv/dochub/storage
DOCHUB_UPLOAD_TEMP_HOST_PATH=/srv/dochub/tmp/uploads
POSTGRES_DATA_HOST_PATH=/srv/dochub/postgres
LETSENCRYPT_HOST_PATH=/srv/dochub/letsencrypt
CERTBOT_WEBROOT_HOST_PATH=/srv/dochub/certbot-webroot

# REQUIRED: public hostnames; no scheme or path. The certificate named after
# WEB_HOST must cover both names (for example, a SAN certificate).
WEB_HOST=docs.example.com
ONLYOFFICE_HOST=office.docs.example.com
WEB_ORIGIN=https://docs.example.com
NGINX_CLIENT_MAX_BODY_SIZE=512m

# REQUIRED: database. URL-encode special characters in POSTGRES_PASSWORD when
# placing it in DATABASE_URL. PostgreSQL is private on the Docker backend net.
POSTGRES_DB=dochub
POSTGRES_USER=dochub
POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password
DATABASE_URL=postgresql://dochub:replace-with-url-encoded-postgres-password@postgres:5432/dochub

# REQUIRED: application runtime/security.
NODE_ENV=production
PORT=3000
STORAGE_DRIVER=local
STORAGE_ROOT=/data/storage
UPLOAD_TEMP_ROOT=/data/uploads
UPLOAD_MAX_BYTES=536870912
API_JSON_BODY_LIMIT_BYTES=1048576
TRUST_PROXY_HOPS=1
AUTH_ACCESS_TOKEN_SECRET=replace-with-a-distinct-random-secret-at-least-32-characters
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_REFRESH_COOKIE_NAME=dochub_refresh
AUTH_REFRESH_COOKIE_SECURE=true
AUTH_REFRESH_COOKIE_SAME_SITE=lax
# AUTH_REFRESH_COOKIE_DOMAIN=docs.example.com

# REQUIRED in production: configure these four values as one Google OAuth
# client. The callback URI must be registered with Google exactly as written.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=https://docs.example.com/api/auth/google/callback
AUTH_LOGIN_SUCCESS_REDIRECT_URL=https://docs.example.com/auth/callback

# REQUIRED for ONLYOFFICE. PUBLIC is browser-facing; INTERNAL_API is resolved
# only on the Docker backend network by Document Server.
ONLYOFFICE_PUBLIC_URL=https://office.docs.example.com
ONLYOFFICE_INTERNAL_API_URL=http://api:3000
ONLYOFFICE_JWT_SECRET=replace-with-a-distinct-random-onlyoffice-jwt-secret-32-chars
ONLYOFFICE_FETCH_TOKEN_SECRET=replace-with-a-distinct-random-fetch-secret-at-least-32-chars
ONLYOFFICE_FETCH_TOKEN_TTL_SECONDS=900
ONLYOFFICE_CALLBACK_TOKEN_TTL_SECONDS=3600

# REQUIRED for worker text extraction; private Docker DNS only.
TIKA_URL=http://tika:9998
TIKA_REQUEST_TIMEOUT_SECONDS=60
TIKA_MAX_TEXT_BYTES=16777216
FILE_PROCESSING_POLL_SECONDS=15
FILE_PROCESSING_BATCH_SIZE=20
FILE_PROCESSING_CONCURRENCY=2
FILE_PROCESSING_LEASE_SECONDS=300
FILE_PROCESSING_MAX_ATTEMPTS=5
TRASH_RETENTION_DAYS=30
TRASH_RETENTION_POLL_SECONDS=60
TRASH_RETENTION_BATCH_SIZE=20
TRASH_RETENTION_OPERATION_CONCURRENCY=1

# OPTIONAL resource tuning. Defaults suit a VPS with at least 6 GB RAM. Raise
# ONLYOFFICE/Tika bounds for large or concurrent documents; do not set them
# below a workload-tested minimum.
API_MEMORY_LIMIT=768m
API_NODE_MAX_OLD_SPACE_MB=512
WORKER_MEMORY_LIMIT=768m
WORKER_NODE_MAX_OLD_SPACE_MB=512
POSTGRES_MEMORY_LIMIT=1g
ONLYOFFICE_MEMORY_LIMIT=2g
TIKA_MEMORY_LIMIT=1g
DOCHUB_IMAGE_TAG=local
# DOCHUB_API_IMAGE=registry.example/dochub-api
# DOCHUB_WORKER_IMAGE=registry.example/dochub-worker
# DOCHUB_WEB_IMAGE=registry.example/dochub-web
